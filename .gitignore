# data/ is ignored except the inputs the notebooks in examples/ need and this workspace cannot generate:
# camera calibrations, recorded/stand-in clips and the measured setup. Everything derived from them is
# regenerated by scripts/ or the notebooks: scans (09/14/15), splats, DISCOVERSE assets (downloaded),
# demos (02), the LeRobot dataset (11), viewer pages (07), markers (01), .analysis caches.
data/**
!data/**/
!data/camera_intrinsics_s10e.npz
!data/camera_intrinsics_s24.npz
!data/raw/overview_gif/hand_moves_cube/frame_*.png
!data/raw/e1/test.mp4
!data/raw/setup_01/measurements.yaml
!data/raw/setup_01/table_scene_zoom_0?.mp4
!data/raw/setup_01/tabletop_charuco_topleft.mp4
assets/*.mp4
assets/*.npz
.venv/
__pycache__/
*.pyc
.env
*.egg-info/
.ruff_cache/
.pytest_cache/
*.md
!CHALLENGE.md
!docs/*.md
results/
outputs/
!eval/*.md
